<%- include('../partials/head') %>

    <body class="bg-gray-50">
        <%- include('../partials/nav') %>

            <main class="min-h-screen flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
                <div class="w-full max-w-md">
                    <!-- Main Card -->
                    <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-gray-100">

                        <!-- Header Section -->
                        <div class="bg-[#ff385c] px-8 py-10 text-center">
                            <div class="flex justify-center mb-4">
                                <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 32 32">
                                    <path
                                        d="M16 1c2.008 0 3.463.963 4.751 3.269l.533 1.025c1.954 3.83 6.114 12.54 7.1 14.836l.145.353c.667 1.591.91 2.472.96 3.396l.01.415.001.228c0 4.062-2.877 6.478-6.357 6.478-2.224 0-4.556-1.258-6.709-3.386l-.257-.26-.172-.179h-.011l-.176.185c-2.044 2.1-4.393 3.405-6.701 3.405-3.48 0-6.358-2.416-6.358-6.479 0-1.142.233-2.156.76-3.417l.128-.293C4.31 16.806 8.161 8.735 10.186 4.927l.535-1.033C12.008 1.963 13.463 1 15.471 1zM16 11c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3z" />
                                </svg>
                            </div>
                            <h1 class="text-3xl font-bold text-white mb-2">Welcome Back</h1>
                            <p class="text-red-100 text-sm">Sign in to your Airbnb account</p>
                        </div>

                        <!-- Form Section -->
                        <div class="p-8 sm:p-10">
                            <form action="/login" method="POST" class="space-y-6">

                                <!-- Email/Username Field -->
                                <div>
                                    <label for="userName" class="block text-sm font-semibold text-gray-700 mb-3">
                                        Email or Username
                                    </label>
                                    <input type="text" id="userName" name="userName"
                                        placeholder="Enter your email or username" required
                                        class="w-full px-4 py-3 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none bg-white border-2 border-gray-300 focus:border-[#ff385c] focus:ring-2 focus:ring-red-100">
                                </div>

                                <!-- Password Field -->
                                <div>
                                    <label for="password" class="block text-sm font-semibold text-gray-700 mb-3">
                                        Password
                                    </label>
                                    <input type="password" id="password" name="password"
                                        placeholder="Enter your password" required
                                        class="w-full px-4 py-3 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none bg-white border-2 border-gray-300 focus:border-[#ff385c] focus:ring-2 focus:ring-red-100">
                                </div>

                                <!-- Remember Me -->
                                <div class="flex items-center justify-between">
                                    <label class="flex items-center">
                                        <input type="checkbox"
                                            class="w-4 h-4 text-[#ff385c] bg-gray-100 border-gray-300 rounded focus:ring-2 focus:ring-[#ff385c]" />
                                        <span class="ml-2 text-sm text-gray-600">Remember me</span>
                                    </label>
                                    <a href="#"
                                        class="text-sm text-[#ff385c] hover:text-[#e00b41] font-medium transition">
                                        Forgot password?
                                    </a>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit"
                                    class="w-full text-white font-bold py-3 px-4 rounded-lg mt-8 active:scale-[0.98] cursor-pointer shadow-md bg-[#ff385c] hover:bg-[#e00b41] transition">
                                    Sign In
                                </button>
                            </form>

                            <!-- Divider -->
                            <div class="my-8 h-px bg-gray-300"></div>

                            <!-- Sign Up Link -->
                            <div class="text-center">
                                <p class="text-gray-600 text-sm">
                                    Don't have an account?
                                    <a href="/signup" class="text-[#ff385c] font-bold hover:text-[#e00b41] transition">
                                        Sign up here
                                    </a>
                                </p>
                            </div>

                            <!-- Help Text -->
                            <div class="mt-8 p-4 bg-blue-50 rounded-lg border border-blue-100">
                                <p class="text-xs text-blue-700 text-center">
                                    <span class="font-semibold">New to Airbnb?</span> Create an account to get started
                                    with amazing stays.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Text -->
                    <p class="text-center text-gray-500 text-xs mt-6">
                        By signing in, you agree to our Terms of Service and Privacy Policy
                    </p>
                </div>
            </main>
    </body>