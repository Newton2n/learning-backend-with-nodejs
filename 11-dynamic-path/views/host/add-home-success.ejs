<%- include('../partials/head') %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-white text-gray-900">

 <!-- Header -->
<%- include('../partials/nav') %>

    <main class="max-w-3xl mx-auto px-8 py-20">
        <div class="text-center">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-green-50 rounded-full mb-6">
                <span class="text-4xl">✅</span>
            </div>
            
            <h1 class="text-4xl font-bold tracking-tight mb-4"> <%= edit ?'Thanks for Editing your home!' :'Thanks for adding your home!' %></h1>


            <p class="text-gray-500 text-lg mb-10"> Your listing has been created successfully and is now being processed.</p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/" class="flex-1 max-w-[200px] border-2 border-gray-900 bg-gray-900 text-white text-center py-3 rounded-xl font-bold hover:bg-black transition">
                    Go to Home
                </a>

                <a href="/host-home-list" class="flex-1 max-w-[200px] border-2 border-gray-200 text-gray-800 text-center py-3 rounded-xl font-bold hover:border-black transition">
                    see your all listing
                </a>
                <a href="/add-home" class="flex-1 max-w-[200px] border-2 border-gray-200 text-gray-800 text-center py-3 rounded-xl font-bold hover:border-black transition">
                    Add another
                </a>
            </div>
        </div>

        <div class="mt-16 p-6 border border-gray-100 rounded-2xl bg-gray-50 flex items-center gap-4">
            
            <div>
                <p class="text-xs font-bold uppercase text-gray-400">Next Step</p>
                <p class="text-sm font-semibold text-gray-800">Your listing will be visible to guests in about 24 hours.</p>
            </div>
        </div>
    </main>

    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-3 flex justify-around items-center md:hidden">
        <a href="/" class="flex flex-col items-center text-rose-500">
            <span class="text-xl">🏠</span>
            <span class="text-[10px] font-bold">Today</span>
        </a>
        <div class="flex flex-col items-center text-gray-400">
            <span class="text-xl">📅</span>
            <span class="text-[10px] font-bold">Calendar</span>
        </div>
        <div class="flex flex-col items-center text-gray-400">
            <span class="text-xl">💬</span>
            <span class="text-[10px] font-bold">Inbox</span>
        </div>
    </div>
  <%- include('../partials/footer') %>
</body>
</html>