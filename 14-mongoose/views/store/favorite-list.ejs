<%- include('../partials/head') %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #222222;
        }

        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
    </head>

    <body class="bg-white">
        <%- include('../partials/nav') %>

            <main class="max-w-[1200px] mx-auto px-6 py-12">
                <div class="mb-10">
                    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Favorites list</h1>
                    <p class="text-sm text-gray-500">0</p>
                </div>
                

                    <div
                    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-4 gap-y-8">

                    <% favoriteHomeList.forEach((item)=> { %>
                        <div class="group cursor-pointer relative">

                            <div class="relative aspect-square w-full overflow-hidden rounded-lg bg-gray-100 mb-2">
                                <button
                                    class="absolute top-2 right-2 z-10 p-1.5 rounded-full hover:bg-white/20 transition-colors group/heart">
                                    <svg class="w-4 h-4 text-white/90 group-hover/heart:text-rose-500 transition-colors"
                                        fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z">
                                        </path>
                                    </svg>
                                </button>

                                <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&q=80&w=600"
                                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                                    alt="<%= item.title %>">
                            </div>

                            <div class="flex flex-col gap-0">
                                <div class="flex justify-between items-start">
                                    <h3 class="font-bold text-[12px] line-clamp-1">
                                        <%= item.title %>
                                    </h3>
                                    <span class="text-[10px] font-medium text-gray-400">
                                        <%= item.category %>
                                    </span>
                                </div>
                                <p class="text-gray-500 text-[11px] line-clamp-1">
                                    <%= item.address %>
                                </p>

                                <div class="flex items-center justify-between mt-2">
                                    <p class="font-bold text-[12px]">
                                        <%= item.price %> $ <span class="font-normal text-gray-400">day</span>
                                    </p>

                                    <form action="/delete-favorite" method="POST">
                                        <input type="hidden" name="homeId" value="<%= item._id %>">
                                    <button type="submit"
                                        class=" bg-[#ff385c] text-white text-[10px] font-bold px-3 py-1 rounded-md
                                        hover:bg-[#e31c5f] transition-colors active:scale-95 cursor-pointer">
                                        Delete from fav
                                        </button>
                                    </form>
                                    <a href="home-details/<%= item.id %>">
                                        <button
                                            class="bg-blue-500 text-white text-[10px] font-bold px-3 py-1 rounded-md hover:bg-blue-700 transition-colors active:scale-95 cursor-pointer">
                                            Details
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }) %>




                </div>

            </main>

            <%- include('../partials/footer') %>
    </body>

    </html>