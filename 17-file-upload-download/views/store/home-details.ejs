<%- include('../partials/head') %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #222222;
        }

        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
    </head>

    <body class="bg-white">

        <!-- Header  -->
        <%- include('../partials/nav') %>

            <div
                class="max-w-sm mx-auto bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 border border-gray-100 group">
                <div class="relative aspect-[4/3] overflow-hidden">
                    <img src="<%= home.img %>"
                        alt="<%= home.title %>"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full shadow-sm">
                        <p class="text-xs font-bold text-gray-900">Guest favorite</p>
                    </div>
                </div>

                <div class="p-4">
                    <div class="flex justify-between items-start mb-1">
                        <h3 class="text-lg font-bold text-gray-900 leading-tight">
                            <%= home.title%>
                        </h3>
                        <div class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            <span class="text-sm font-medium">4.9</span>
                        </div>
                    </div>

                    <p class="text-gray-500 text-sm font-medium mb-3">
                        <%= home.address%>
                    </p>
                    <p class="text-gray-500 text-sm font-medium mb-3">
                        <%= home.category%>
                    </p>

                    <div class="flex items-end gap-1">
                        <span class="text-xl font-bold text-gray-900">$ <%= home.price%></span>
                        <span class="text-gray-500 text-sm mb-0.5">night</span>
                    </div>
                    <form action="/favorites" method="POST">
                        <input type="hidden" name="homeId" value="<%= home.id %>">
                        <button type="submit"
                            class="w-full mt-4 bg-[#ff385c] hover:bg-[#e31c5f] text-white font-bold py-2.5 rounded-xl transition-colors active:scale-95 duration-100">
                            Add to favorite
                        </button>
                    </form>
                    <form action="/delete-home" method="POST">
                        <input type="hidden" name="homeId" value="<%= home.id %>">
                        <button type="submit"
                            class="w-full mt-4 bg-[#ff385c] hover:bg-[#e31c5f] text-white font-bold py-2.5 rounded-xl transition-colors active:scale-95 duration-100">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

            <%- include('../partials/footer') %>
    </body>

    </html>