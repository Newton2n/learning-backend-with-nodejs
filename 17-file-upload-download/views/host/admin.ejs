<%- include('../partials/head') %>
</head>

<body class="bg-gray-50 text-[#222222] min-h-screen flex flex-col">

   <%- include('../partials/nav') %>

    <div class="flex flex-1 overflow-hidden">
        <main class="flex-1 max-w-[1400px] mx-auto w-full p-4 md:p-8 overflow-y-auto">

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold tracking-tight">Property Overview</h1>
                    <p class="text-gray-500 text-sm">Welcome back, here is what's happening today.</p>
                </div>
                <a href="/add-home"
                    class="bg-[#ff385c] text-white px-6 py-3 rounded-xl font-semibold hover:bg-[#e31c5f] transition shadow-md active:scale-95 text-center">
                    + Add New Listing
                </a>
            </div>

            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition">
                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Total Revenue</p>
                    <h3 class="text-3xl font-bold mt-2">$12,450.00</h3>
                    <span class="text-green-600 text-xs font-bold inline-flex items-center mt-3 bg-green-50 px-2 py-1 rounded-md">
                        ↑ 12% <span class="ml-1 font-medium text-green-700">vs last month</span>
                    </span>
                </div>
                
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition">
                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Active Bookings</p>
                    <h3 class="text-3xl font-bold mt-2">42</h3>
                    <span class="text-blue-600 text-xs font-bold inline-flex items-center mt-3 bg-blue-50 px-2 py-1 rounded-md">
                         8 checking in today
                    </span>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition">
                    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Avg. Rating</p>
                    <div class="flex items-center gap-3 mt-2">
                        <h3 class="text-3xl font-bold">4.85</h3>
                        <div class="flex text-yellow-400">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                        </div>
                    </div>
                    <span class="text-gray-400 text-xs block mt-3 font-medium">Out of 1,240 reviews</span>
                </div>
            </section>

            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold tracking-tight">Recent Listings</h2>
                <button class="text-sm font-semibold text-gray-500 hover:text-black transition">View All</button>
            </div>

            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50/50 border-b border-gray-100">
                                <th class="px-6 py-4 text-[11px] font-bold text-gray-400 uppercase tracking-widest">Property</th>
                                <th class="px-6 py-4 text-[11px] font-bold text-gray-400 uppercase tracking-widest">Location</th>
                                <th class="px-6 py-4 text-[11px] font-bold text-gray-400 uppercase tracking-widest">Price/Night</th>
                                <th class="px-6 py-4 text-[11px] font-bold text-gray-400 uppercase tracking-widest">Status</th>
                                <th class="px-6 py-4 text-[11px] font-bold text-gray-400 uppercase tracking-widest text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <tr class="hover:bg-gray-50/80 transition group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <img src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=100&h=100&q=80"
                                            class="w-12 h-12 rounded-xl object-cover shadow-sm group-hover:scale-105 transition-transform" alt="Property">
                                        <span class="font-bold text-sm">Beachfront Villa</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-gray-500 text-sm">Malibu, CA</td>
                                <td class="px-6 py-4 font-bold text-sm">$520</td>
                                <td class="px-6 py-4">
                                    <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-tight">Active</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex justify-end gap-2 text-gray-400">
                                        <button class="p-2 hover:bg-blue-50 hover:text-blue-500 rounded-lg transition"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg></button>
                                        <button class="p-2 hover:bg-red-50 hover:text-red-500 rounded-lg transition"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>
                                    </div>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50/80 transition group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=100&h=100&q=80"
                                            class="w-12 h-12 rounded-xl object-cover shadow-sm group-hover:scale-105 transition-transform" alt="Property">
                                        <span class="font-bold text-sm">Paris Loft</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-gray-500 text-sm">Paris, France</td>
                                <td class="px-6 py-4 font-bold text-sm">$310</td>
                                <td class="px-6 py-4">
                                    <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-tight">Active</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2 text-gray-400">
                                        <button class="p-2 hover:bg-blue-50 hover:text-blue-500 rounded-lg transition"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg></button>
                                        <button class="p-2 hover:bg-red-50 hover:text-red-500 rounded-lg transition"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>